# Copy to .env at the repo root. `just net up <id>` copies the keys listed under
# `env_keys` in dpi-network.yaml into each device's ~/.dpi/backend.env.
OPENROUTER_API_KEY=sk-or-...

# Optional: run a device against your own llama.cpp server instead of OpenRouter. Set
# DPI_PROVIDER and DPI_LLAMA_URL as plain `env:` entries in dpi-network.yaml (they are not
# secrets), and add DPI_LLAMA_API_KEY here only if the server was started with --api-key.
# DPI_LLAMA_API_KEY=

# Optional: call Jev through TypeSafe directly instead of OpenRouter (jev-damage-control).
# Add it to `env_keys` in dpi-network.yaml to send it to your devices.
# TYPESAFE_API_KEY=
